// Shairport Sync configuration for Pynab (AirPlay 1 only).
// Generated from nabairplay/shairport-sync.conf.in by install-airplay.sh.
general =
{
  name = "Nabaztag";
  output_backend = "alsa";
  default_airplay_volume = 0.0;
  ignore_volume_control = "yes";
  volume_max_db = 0.0;
  // no control/metadata interface is enabled: nothing is exposed besides AirPlay
};

alsa =
{
  output_device = "@ALSA_DEVICE@";
};

sessioncontrol =
{
  run_this_before_play_begins = "/bin/bash @ROOT_DIR@/nabairplay/airplay-on.sh";
  run_this_after_play_ends = "/bin/bash @ROOT_DIR@/nabairplay/airplay-off.sh";
  wait_for_completion = "yes";
  allow_session_interruption = "yes";
  session_timeout = 20;
};
